# Copy to .env and fill in. Never commit the real .env.
#
# We call models through a LiteLLM gateway (an OpenAI-style proxy), so you do NOT
# need a direct Claude/OpenAI key — just the proxy base URL + key from your team.
#
# Retrieval & Memory exercises need NONE of this (they run on local embeddings).
# Only the generation layer (src/rag.py) uses it.
#
# List available model names:
#   curl $LITELLM_PROXY_API_BASE/v1/models -H "Authorization: Bearer $LITELLM_PROXY_API_KEY"

LLM_MODEL=litellm_proxy/openai/gpt-4.1-mini
LITELLM_PROXY_API_BASE=https://your-litellm-proxy.example.com
LITELLM_PROXY_API_KEY=sk-...

# --- Tavily (required for Layer 4 — web search tool in notebooks/agents) ---
# Sign up at https://tavily.com/ for a free API key.
TAVILY_API_KEY=tvly-...

# --- LangSmith (required for Layer 4 — agent & graph observability) ---
# LangSmith traces every LLM call, tool invocation, and graph step so you can
# see exactly what happened during an agent run. This is NOT optional for the
# agent/graph exercises — you need it to debug and understand the flow.
# Sign up at https://smith.langchain.com/ for a free API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-...
LANGSMITH_PROJECT=onboarding-assistant

# --- Evaluation & production (optional, Layer 6) ---
# Judge model for LLM-as-judge (defaults to LLM_MODEL). Seconds before a call gives up.
# JUDGE_MODEL=litellm_proxy/anthropic/claude-sonnet-5
# LLM_TIMEOUT=60
